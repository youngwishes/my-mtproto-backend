# django
DJANGO_SECRET_KEY=<SECRET_KEY>
DEBUG=1

# telegram bot
BOT_LINK=https://t.me/<BOT_NAME>
BOT_TOKEN=<BOT_TOKEN_FROM_BOTFATHER>
BOT_AUTH_TOKEN=<AUTH_TOKEN_FOR_API>

# flower
FLOWER_USER=admin
FLOWER_PASSWORD=admin

# celery & redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# other
MY_TELEGRAM_ID=<YOUR_TELEGRAM_ID/SUPPORT_GROUP_TELEGRAM_ID>
# Админ-оповещения об ошибках (🟡 SERVICE / 🔴 INFRA). true в проде; false для
# локального/интеграционного стека, чтобы error-path e2e не слали реальные сообщения.
ERROR_NOTIFICATIONS_ENABLED=true
TELEGRAM_TIMEOUT=5
VDS_REQUEST_TIMEOUT=10

# vless sales (fail closed by default)
VPN_SALES_ENABLED=0
VPN_AGENT_CONTRACT_VERSION=v1
VPN_AGENT_SNAPSHOT_SCHEMA_VERSION=1.0
VPN_AGENT_EXPECTED_SHA=20ae654fc460163fe80aa82051ea9bb22f6d664a
VPN_AGENT_EXPECTED_XRAY_VERSION=26.7.11
VPN_AGENT_EXPECTED_XRAY_IMAGE_DIGEST=sha256:a1644183accdb0b5be967093fe34be756fd5de15fe2ee0206e842ae17350967f
VPN_AGENT_MAX_RESPONSE_BYTES=65536
VPN_AGENT_CONNECT_TIMEOUT_SECONDS=2.0
VPN_AGENT_READ_TIMEOUT_SECONDS=10.0
VPN_PAYMENT_INTENT_TTL_SECONDS=900

# litestream
LITESTREAM_ACCESS_KEY_ID=<ACCESS_KEY_ID>
LITESTREAM_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>
