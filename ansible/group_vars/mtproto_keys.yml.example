---
ansible_user: root

deploy_project_name: my-mtproto-backend
deploy_root: /root/my-mtproto-backend
deploy_repository: https://github.com/youngwishes/my-mtproto-backend.git

# Полный SHA коммита для воспроизводимого деплоя. Можно передать через -e.
deploy_revision: ""
deploy_db_path: "{{ deploy_root }}/data/db.sqlite3"

# Проверка после деплоя через публичный Django-host.
deploy_healthcheck_host: dash.mtprotokeys.com
deploy_healthcheck_url: https://127.0.0.1/
deploy_healthcheck_status_codes:
  - 200
deploy_validate_certs: false

deploy_required_services:
  - django
  - nginx
  - redis
  - celery-worker
  - celery-beat
  - flower
  - litestream
  - bot
