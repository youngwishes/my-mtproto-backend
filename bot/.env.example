# Telegram bot runtime secrets. Copy to bot/.env and replace placeholders.
TELEGRAM_BOT_TOKEN=<BOT_TOKEN_FROM_BOTFATHER>
API_URL=http://django:8000
MY_TELEGRAM_ID=<SUPPORT_CHAT_ID>
BOT_AUTH_TOKEN=<MATCH_ROOT_BOT_AUTH_TOKEN>
PROVIDER_TOKEN=<YUKASSA_PROVIDER_TOKEN>

# Do not duplicate VPN_SALES_ENABLED here. Docker Compose injects it into the
# bot from the canonical root .env and defaults both backend and bot to false.
